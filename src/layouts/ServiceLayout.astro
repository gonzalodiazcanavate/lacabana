---
import type { ImageMetadata } from 'astro';
import PageLayout from './PageLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { services, site } from '../data/site';

interface Props {
  title: string;
  description: string;
  heading?: string;
  formHeading: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { title, description, heading, formHeading, image, imageAlt } = Astro.props;
const path = Astro.url.pathname;
const hasAfter = Astro.slots.has('after');

const perks = ['Presupuesto gratis y sin compromiso', 'Más de 20 años de experiencia', 'Equipo propio de más de 10 profesionales'];
---

<PageLayout
  title={title}
  description={description}
  heading={heading}
  eyebrow="Servicios · Reformas La Cabaña"
  bg={image}
  bgAlt={imageAlt}
  crumbs={[{ label: 'Servicios' }]}
>
  <div class="container-page grid gap-12 py-14 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="min-w-0">
      <div class="content-prose">
        <h2>{formHeading}</h2>
        <slot />
      </div>

      <div class="panel mt-10">
        <h2 class="mb-1 text-xl font-extrabold text-ink-900">Solicita tu presupuesto</h2>
        <p class="mb-6 text-sm text-gray-600">Cuéntanos qué necesitas y te respondemos en menos de tres días.</p>
        <QuoteForm idPrefix="servicio" />
      </div>

      {
        hasAfter && (
          <div class="content-prose mt-14">
            <slot name="after" />
          </div>
        )
      }
    </div>

    <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
      <div class="rounded-xl bg-ink-900 p-6 text-white shadow-lg">
        <h2 class="text-lg font-extrabold">¿Por qué elegirnos?</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {
            perks.map((p) => (
              <li class="flex gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-500 text-xs font-extrabold text-ink-900" aria-hidden="true">✓</span>
                {p}
              </li>
            ))
          }
        </ul>
        <a href={site.phoneHref} class="btn btn-primary mt-6 w-full normal-case">Llamar {site.phone}</a>
      </div>

      <nav aria-label="Otros servicios" class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-extrabold text-ink-900">Nuestros servicios</h2>
        <ul class="mt-3 divide-y divide-gray-100 text-sm">
          {
            services.map((s) => (
              <li>
                <a
                  href={s.href}
                  aria-current={path === s.href ? 'page' : undefined}
                  class:list={[
                    'flex items-center justify-between py-2.5 font-semibold hover:text-brand-700',
                    path === s.href ? 'text-brand-700' : 'text-ink-700',
                  ]}
                >
                  {s.label}
                  <span aria-hidden="true" class="text-brand-500">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>
</PageLayout>
