---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from './Layout.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props {
  title: string;
  description: string;
  heading?: string;
  subtitle?: string;
  eyebrow?: string;
  bg?: ImageMetadata;
  bgAlt?: string;
  type?: 'website' | 'article';
  cta?: boolean;
  crumbs?: { label: string; href?: string }[];
}

const { title, description, heading = title, subtitle, eyebrow, bg, bgAlt = '', type, cta = true, crumbs = [] } = Astro.props;
---

<Layout title={title} description={description} image={bg?.src} type={type}>
  <section class="relative isolate overflow-hidden bg-ink-900 text-white">
    {
      bg ? (
        <>
          <Image src={bg} alt={bgAlt} widths={[768, 1280, 1920]} sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover" loading="eager" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-900/95 via-ink-900/75 to-ink-900/40" />
        </>
      ) : (
        <div
          class="absolute inset-0 -z-10"
          style="background-image: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.05) 0 2px, transparent 2px 22px), linear-gradient(to bottom right, var(--color-brand-600), var(--color-ink-800) 55%, var(--color-ink-900));"
        />
      )
    }
    <div class="container-page py-16 sm:py-24">
      <nav aria-label="Migas de pan" class="mb-6 text-sm text-gray-300">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-brand-500">Inicio</a></li>
          {
            crumbs.map((c) => (
              <li class="flex items-center gap-2">
                <span aria-hidden="true" class="text-brand-500">/</span>
                {c.href ? <a href={c.href} class="hover:text-brand-500">{c.label}</a> : c.label}
              </li>
            ))
          }
          <li class="flex items-center gap-2" aria-current="page">
            <span aria-hidden="true" class="text-brand-500">/</span>
            <span class="text-white">{title}</span>
          </li>
        </ol>
      </nav>
      {eyebrow && <p class="mb-3 text-sm font-bold uppercase tracking-widest text-brand-500">{eyebrow}</p>}
      <h1 class="max-w-3xl text-3xl font-extrabold tracking-tight sm:text-5xl">{heading}</h1>
      <span class="mt-6 block h-1.5 w-20 rounded bg-brand-500"></span>
      {subtitle && <p class="mt-6 max-w-2xl text-lg text-gray-200">{subtitle}</p>}
      <slot name="banner" />
    </div>
  </section>
  <slot />
  {cta && <CtaBand />}
</Layout>
