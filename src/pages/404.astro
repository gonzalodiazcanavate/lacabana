---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="La página que buscas no existe.">
  <section class="container-page py-32 text-center">
    <p class="text-6xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-extrabold text-ink-900">Página no encontrada</h1>
    <p class="mt-4 text-gray-600">La página que buscas no existe o ha cambiado de dirección.</p>
    <a href="/" class="btn btn-primary mt-8">Volver al inicio</a>
  </section>
</Layout>
