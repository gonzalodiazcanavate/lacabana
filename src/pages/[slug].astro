---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, image, imageAlt, categories } = post.data;
const dateLabel = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long', timeZone: 'UTC' }).format(date);
---

<PageLayout
  title={title}
  description={description}
  bg={image}
  bgAlt={imageAlt}
  type="article"
  eyebrow="Blog de reformas"
  crumbs={[{ label: 'Blog', href: '/blog-de-reformas/' }]}
>
  <article class="container-page max-w-3xl py-14">
    <div class="mb-10 flex flex-wrap items-center gap-x-4 gap-y-3 border-b border-gray-200 pb-6">
      <time datetime={date.toISOString()} class="text-sm font-semibold text-gray-500">{dateLabel}</time>
      <ul class="flex flex-wrap gap-2" aria-label="Categorías">
        {
          categories.map((c) => (
            <li>
              <a href={`/blog-de-reformas/?categoria=${encodeURIComponent(c)}`} class="chip">{c}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="content-prose [&>p:first-child]:text-xl [&>p:first-child]:leading-9 [&>p:first-child]:text-ink-900">
      <Content />
    </div>
    <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-gray-200 pt-6">
      <a href="/blog-de-reformas/" class="font-bold text-brand-700 hover:underline">&larr; Volver al blog</a>
      <a href="/presupuesto-reforma-murcia/" class="btn btn-primary">Pide tu presupuesto</a>
    </div>
  </article>
</PageLayout>
