---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import administrativa from '../assets/img/administrativa.webp';
import hormigonera from '../assets/img/trabajadores-hormigonera.webp';
import { site } from '../data/site';
---

<PageLayout
  title="Contacto"
  description="En Reformas La Cabaña S.L somos tu empresa de construcción y reformas en Murcia de confianza. Entra en contacto con nosotros o visitanos."
  eyebrow="Estamos a tu disposición"
  subtitle="Llámanos, escríbenos o visítanos en nuestra sede de Fuente Álamo."
  cta={false}
>
  <div class="container-page py-14">
    <div class="grid items-start gap-8 lg:grid-cols-3">
      <div class="rounded-xl border-t-4 border-brand-500 bg-white p-6 shadow-lg ring-1 ring-black/5">
        <h2 class="text-xl font-bold text-ink-900">Teléfono</h2>
        <p class="mt-3">
          Llama al <a href={site.phoneHref} class="font-semibold text-brand-700 hover:underline">{site.phone}</a> o escríbenos por
          <a href={site.whatsappHref} rel="noopener noreferrer" class="font-semibold text-brand-700 hover:underline">WhatsApp</a>.
          Atendemos de lunes a viernes, de 9:00 a 14:00 y de 16:00 a 20:00.
        </p>
      </div>
      <div class="rounded-xl border-t-4 border-brand-500 bg-white p-6 shadow-lg ring-1 ring-black/5">
        <h2 class="text-xl font-bold text-ink-900">Visítanos</h2>
        <p class="mt-3">{site.address}</p>
        <a href={site.mapsUrl} rel="noopener noreferrer" class="mt-2 inline-block font-semibold text-brand-700 hover:underline">Cómo llegar en Google Maps</a>
        <a href={site.reviewUrl} rel="noopener noreferrer" class="mt-2 block font-semibold text-brand-700 hover:underline">Déjanos tu reseña en Google</a>
        <iframe
          src={site.mapEmbed}
          title="Ubicación La Cabaña SL"
          class="mt-4 h-52 w-full rounded-md border-0"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="rounded-xl border-t-4 border-brand-500 bg-white p-6 shadow-lg ring-1 ring-black/5">
        <h2 class="text-xl font-bold text-ink-900">Email</h2>
        <p class="mt-3">
          También puedes contactarnos por email en
          <a href={`mailto:${site.email}`} class="break-all font-semibold text-brand-700 hover:underline">{site.email}</a>, nuestro
          equipo contestará con la mayor brevedad posible.
        </p>
      </div>
    </div>

    <div class="mt-14 grid items-center gap-10 lg:grid-cols-2">
      <Image src={hormigonera} alt="Trabajadores realizando una reforma con una hormigonera." widths={[480, 768, 1024]} sizes="(min-width: 1024px) 560px, 100vw" class="w-full rounded-xl object-cover shadow-lg" />
      <div class="panel">
        <h2 class="section-title mb-6">Pide tu Presupuesto</h2>
        <QuoteForm idPrefix="contacto" />
      </div>
    </div>
  </div>
</PageLayout>
