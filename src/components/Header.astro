---
import { Image } from 'astro:assets';
import logo from '../assets/img/cropped-logo.jpg';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => href !== '#' && (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-50 bg-ink-900 text-white shadow-lg">
  <div class="hidden border-b-2 border-brand-500 bg-surface text-ink-700 lg:block">
    <div class="container-page flex items-center justify-end gap-6 py-1.5 text-xs font-semibold">
      <a href={site.phoneHref} class="hover:underline">{site.phone}</a>
      <a href={`mailto:${site.email}`} class="hover:underline">{site.email}</a>
    </div>
  </div>

  <div class="container-page flex flex-wrap items-center justify-between py-3">
    <a href="/" class="flex items-center gap-3">
      <Image src={logo} alt={`Logo de la empresa ${site.name}`} width={48} height={48} class="h-12 w-12 rounded" loading="eager" />
      <span class="text-lg font-extrabold tracking-tight">{site.domain}</span>
    </a>

    <button
      type="button"
      id="menu-toggle"
      class="rounded p-2 hover:bg-white/10 lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <nav id="main-nav" aria-label="Menú" class="hidden w-full overflow-y-auto overscroll-contain max-lg:fixed max-lg:inset-0 max-lg:-z-10 max-lg:bg-ink-900 max-lg:px-4 max-lg:pb-8 max-lg:pt-[4.75rem] lg:block lg:w-auto lg:overflow-visible">
      <ul class="flex flex-col gap-0.5 py-2 lg:flex-row lg:items-center lg:gap-1 lg:py-0">
        {
          nav.map((item) => (
            <li class="group relative">
              {item.children ? (
                <button
                  type="button"
                  aria-expanded="false"
                  aria-haspopup="true"
                  class:list={[
                    'submenu-toggle flex w-full items-center justify-between gap-1 rounded px-3 py-3 text-left text-base font-semibold lg:py-2 lg:text-sm hover:text-brand-500 lg:w-auto lg:justify-start',
                    item.children.some((c) => isActive(c.href)) && 'text-brand-500',
                  ]}
                >
                  {item.label}
                  <svg class="chevron h-4 w-4 shrink-0 transition-transform lg:group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    'block rounded px-3 py-3 text-base font-semibold hover:text-brand-500 lg:py-2 lg:text-sm',
                    isActive(item.href) && 'text-brand-500',
                  ]}
                >
                  {item.label}
                </a>
              )}
              {item.children && (
                <ul class="submenu hidden pl-4 lg:block lg:invisible lg:absolute lg:left-0 lg:top-full lg:w-64 lg:rounded-b-md lg:bg-ink-800 lg:py-2 lg:opacity-0 lg:shadow-xl lg:transition lg:group-focus-within:visible lg:group-focus-within:opacity-100 lg:group-hover:visible lg:group-hover:opacity-100">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          'block px-3 py-2.5 text-base hover:text-brand-500 lg:px-4 lg:py-2 lg:text-sm',
                          isActive(child.href) && 'text-brand-500',
                        ]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        <li class="max-lg:px-3 max-lg:pt-4 lg:ml-2">
          <a href="/presupuesto-reforma-murcia/" class="btn btn-primary !px-4 !py-2 text-xs">Presupuesto</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    document.body.classList.toggle('overflow-hidden', open);
  });

  document.querySelectorAll<HTMLButtonElement>('.submenu-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      btn.nextElementSibling?.classList.toggle('hidden', !open);
      btn.querySelector('.chevron')?.classList.toggle('rotate-180', open);
    });
  });
</script>
